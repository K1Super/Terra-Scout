<?xml version="1.0" encoding="UTF-8"?>
<!--
  terra-scout-env：环境注入 / 命令白名单执行 / env.ps1
  DoD：环境注入正确 + 注入被拦截（命令白名单）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.terrascout</groupId>
        <artifactId>terra-scout-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>terra-scout-env</artifactId>
    <name>Terra Scout Env</name>
    <description>进程级环境注入、命令白名单执行与 env.ps1 生成</description>

    <dependencies>
        <dependency>
            <groupId>com.terrascout</groupId>
            <artifactId>terra-scout-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率门禁（生产级 ≥ 80%） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>