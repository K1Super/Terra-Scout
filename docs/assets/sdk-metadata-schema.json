{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://terrascout.dev/schemas/sdk-metadata.json",
  "title": "Terra Scout SDK Metadata",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "sdks"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "元数据 schema 版本",
      "example": "1.0"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "元数据最后更新时间"
    },
    "source": {
      "type": "string",
      "enum": ["curated-seed", "official-refresh"],
      "description": "元数据来源：curated-seed=首启落盘的内置种子；official-refresh=官方源在线刷新后写回",
      "example": "official-refresh"
    },
    "sdks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/sdkEntry"
      }
    }
  },
  "definitions": {
    "sdkEntry": {
      "type": "object",
      "required": [
        "language", "version", "os", "arch",
        "url", "sha256", "lts", "eol"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["JAVA", "NODE", "PYTHON", "GO"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}([._-][A-Za-z0-9]+)?$",
          "description": "完整版本号，不允许范围",
          "example": "17.0.9"
        },
        "os": {
          "type": "string",
          "enum": ["WINDOWS", "MACOS", "LINUX"]
        },
        "arch": {
          "type": "string",
          "enum": ["AMD64", "ARM64"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "HTTPS 下载地址"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "lts": {
          "type": "boolean",
          "description": "是否 LTS 版本"
        },
        "eol": {
          "type": "boolean",
          "description": "是否已停止维护"
        },
        "eolDate": {
          "type": "string",
          "format": "date",
          "nullable": true
        },
        "cveCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "highestCveSeverity": {
          "type": "string",
          "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"],
          "default": "NONE"
        },
        "license": {
          "type": "string",
          "description": "SPDX 许可证标识",
          "example": "GPL-2.0-with-classpath-exception"
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "distribution": {
          "type": "string",
          "description": "发行版名称",
          "example": "Temurin"
        },
        "vendor": {
          "type": "string",
          "example": "Eclipse Adoptium"
        }
      }
    }
  }
}
