<?xml version="1.0" encoding="UTF-8"?>
<!--
  terra-scout-app：SpringBoot 内核启动模块
  DoD（master-plan §7）：OpenAPI 契约 + 校验/Token 拦截 + Flyway V1 + 审计 hash 链
  依赖：core / parser / download / task / env；H2 原生模式（D-011）、Flyway 唯一账本（D-005）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.terrascout</groupId>
        <artifactId>terra-scout-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>terra-scout-app</artifactId>
    <name>Terra Scout App</name>
    <description>SpringBoot 内核：Controller/拦截器/Service/Repository/Flyway V1/审计 hash 链</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.terrascout</groupId>
            <artifactId>terra-scout-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.terrascout</groupId>
            <artifactId>terra-scout-parser</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.terrascout</groupId>
            <artifactId>terra-scout-download</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.terrascout</groupId>
            <artifactId>terra-scout-task</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.terrascout</groupId>
            <artifactId>terra-scout-env</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot 生态：spring-boot-dependencies BOM 统一版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率门禁（生产级 ≥ 80%） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 显式绑定 repackage：本项目为自定义父 POM（非 spring-boot-starter-parent），
                     默认执行不被继承，若不显式声明则只产瘦 jar（无主清单、不内嵌依赖），
                     Electron 无法 java -jar 启动内核（冒烟实测定位）。 -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>